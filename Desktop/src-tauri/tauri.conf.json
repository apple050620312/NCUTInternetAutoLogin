{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NCUT Auto Login",
  "version": "4.0.0",
  "identifier": "tw.edu.ncut.autologin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "NCUT 校園網路", "width": 900, "height": 720, "minWidth": 420, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "勤益校園網路自動登入",
    "category": "Utility"
  }
}
